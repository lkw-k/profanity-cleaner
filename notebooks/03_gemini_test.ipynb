   "source": [
    "import os\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# .env 파일 읽기 (노트북은 한 단계 위 폴더로 가야 .env에 닿음)\n",
    "load_dotenv(dotenv_path='../.env')\n",
    "\n",
    "api_key = os.getenv('GEMINI_API_KEY')\n",
    "if api_key:\n",
    "    print(\"API 키가 성공적으로 로드되었습니다.\")\n",
    "else:\n",
    "    print(\"API 키를 찾을 수 없습니다. .env 파일을 확인하세요.\")"
   ]
